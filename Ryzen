    local function apply(cfg, data)
        for k, v in pairs(data or {}) do
            if cfg[k] ~= nil and typeof(cfg[k]) == typeof(v) then cfg[k] = v end
        end
    end
    local function ensure()
        if not hasFS then return false end
        if not isfolder(DIR) then makefolder(DIR) end
        if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
        return true
    end
    local function clean(n) return (n or ""):gsub("[^%w_%-]", ""):sub(1, 24) end
    local function cfgPath(n) return CFG_DIR .. "/" .. n .. ".json" end
    local function listCfgs()
        local out = {}
        if ensure() then
            local ok, files = pcall(listfiles, CFG_DIR)
            if ok then
                for _, f in ipairs(files) do
                    local n = f:match("([^/\\]+)%.json$")
                    if n then out[#out + 1] = n end
                end
            end
        end
        table.sort(out)
        return out
    end
    local function saveCfg(name)
        name = clean(name)
        if name == "" then return log("cfg: enter a name") end
        if not ensure() then return log("cfg: no file access") end
        local ok = pcall(writefile, cfgPath(name), HttpService:JSONEncode({
            esp = snapshot(EC), aim = snapshot(AC), ex = snapshot(XC),
        }))
        log(ok and ("cfg saved: " .. name) or "cfg: save failed")
    end
    local function loadCfg(name)
        name = clean(name)
        if not (ensure() and name ~= "" and isfile(cfgPath(name))) then return log("cfg: not found") end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
        if ok and type(data) == "table" then
            apply(EC, data.esp)
            apply(AC, data.aim)
            apply(XC, data.ex)
            log("cfg loaded: " .. name)
        else
            log("cfg: corrupt file")
        end
    end
    local function deleteCfg(name)
        name = clean(name)
        if not (ensure() and delfile and isfile(cfgPath(name))) then return log("cfg: cannot delete") end
        pcall(delfile, cfgPath(name))
        log("cfg deleted: " .. name)
    end

    local autoName = "none"
    local function readAuto()
        if ensure() and isfile(AUTO) then
            local ok, s = pcall(readfile, AUTO)
            if ok then return clean(s) end
        end
        return ""
    end

    section(P, "CONFIG MANAGER")
    if not hasFS then log("warning: executor has no file api") end

    local nameBox
    do
        local row, s = rowFrame(P, 26)
        label({Size = UDim2.fromOffset(70, 26), Position = UDim2.fromOffset(8, 0), Text = "> name", Parent = row})
        nameBox = make("TextBox", {
            Size = UDim2.new(1, -86, 0, 20), Position = UDim2.fromOffset(78, 3), BackgroundColor3 = BLACK,
            BorderSizePixel = 0, Text = "default", PlaceholderText = "config name", PlaceholderColor3 = DIM,
            TextColor3 = RED, Font = FONT, TextSize = 14, ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
        }, {stroke(DIM)})
        nameBox.Focused:Connect(function() s.Color = RED end)
        nameBox.FocusLost:Connect(function() s.Color = DIM nameBox.Text = clean(nameBox.Text) end)
    end

    local cfgList, selVal = listCfgs(), nil
    do
        local row, s = rowFrame(P, 24)
        label({Size = UDim2.new(1, -170, 1, 0), Position = UDim2.fromOffset(8, 0), Text = "> saved", Parent = row})
        selVal = label({
            Size = UDim2.fromOffset(160, 24), Position = UDim2.new(1, -166, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Right, Text = #cfgList > 0 and "< click >" or "< none >", Parent = row,
        })
        local btn = make("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = row})
        hover(btn, s)
        btn.MouseButton1Click:Connect(function()
            cfgList = listCfgs()
            if #cfgList == 0 then selVal.Text = "< none >" return end
            local nxt = cfgList[(table.find(cfgList, nameBox.Text) or 0) % #cfgList + 1]
            nameBox.Text = nxt
            selVal.Text = "< " .. nxt .. " >"
        end)
    end

    local autoLbl
    do
        local row = rowFrame(P, 22)
        autoLbl = label({Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 12, TextColor3 = MID, Parent = row})
    end
    local function paintAuto() autoLbl.Text = "  autoload: " .. (autoName ~= "" and autoName or "none") end

    buttonRow(P, {
        {"SAVE", function() saveCfg(nameBox.Text) end},
        {"LOAD", function() loadCfg(nameBox.Text) end},
        {"DELETE", function() deleteCfg(nameBox.Text) end},
    })
    buttonRow(P, {
        {"SET AUTO", function()
            local n = clean(nameBox.Text)
            if n ~= "" and ensure() then
                pcall(writefile, AUTO, n)
                autoName = n
                paintAuto()
                log("autoload -> " .. n)
            end
        end},
        {"CLEAR AUTO", function()
            if ensure() then pcall(writefile, AUTO, "") end
            autoName = ""
            paintAuto()
            log("autoload cleared")
        end},
    })
    section(P, "SESSION")
    buttonRow(P, {{"UNLOAD ALL", function() unloadAll() end}})

    -- autoload on start
    autoName = readAuto()
    paintAuto()
    if autoName ~= "" then
        nameBox.Text = autoName
        loadCfg(autoName)
    end

    -- drag
    local dragging, dragStart, startPos = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, root.Position
        end
    end)
    track(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    -- collapse
    local collapsed = false
    minBtn.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        tabBar.Visible, area.Visible, logBox.Visible, footer.Visible =
            not collapsed, not collapsed, not collapsed, not collapsed
        minBtn.Text = collapsed and "[+]" or "[-]"
        TweenService:Create(root, TweenInfo.new(0.22, Enum.EasingStyle.Quad),
            {Size = collapsed and UDim2.fromOffset(360, HEAD) or FULL}):Play()
    end)

    -- keys: Insert hide, F6 quick save, Delete panic
    track(UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == Enum.KeyCode.Insert then
            root.Visible = not root.Visible
        elseif i.KeyCode == Enum.KeyCode.F6 then
            saveCfg(nameBox.Text)
        elseif i.KeyCode == Enum.KeyCode.Delete then
            unloadAll()
        end
    end))

    -- lifecycle
    local destroyed, dying = false, false
    local function destroy()
        if destroyed then return end
        destroyed = true
        pcall(function() RunService:UnbindFromRenderStep("RW_GUI_STEP") end)
        for _, c in ipairs(conns) do c:Disconnect() end
        gui:Destroy()
        if genv.RW_GUI and genv.RW_GUI.Destroy == destroy then genv.RW_GUI = nil end
    end

    local acc, frames, lastBlink = 0, 0, nil
    RunService:BindToRenderStep("RW_GUI_STEP", Enum.RenderPriority.Camera.Value + 4, function(dt)
        if genv.RW_ESP ~= ESP then
            if not dying then
                dying = true
                task.defer(unloadAll)
            end
            return
        end
        for _, f in ipairs(refreshers) do f() end

        local blink = math.floor(tick() * 2) % 2 == 0
        if blink ~= lastBlink then
            lastBlink = blink
            title.Text = "ryzeware@urban-reload:~$ " .. (blink and "_" or " ")
        end

        acc += dt
        frames += 1
        if acc >= 0.25 then
            wmText.Text = string.format("ryzeware | %d fps", math.floor(frames / acc + 0.5))
            acc, frames = 0, 0
        end
    end)

    genv.RW_GUI = {Destroy = destroy}
    selectTab("AIM")
    TweenService:Create(root, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = FULL}):Play()

    task.spawn(function()
        local boot = {
            "ryzeware v1.1",
            "esp: ready",
            "aim: ready",
            "extras: ready",
            hookmetamethod and "silent hooks: ok" or "silent hooks: unsupported",
            hasFS and "configs: ok" or "configs: unsupported",
        }
        for _, s in ipairs(boot) do
            log(s)
            task.wait(0.18)
        end
    end)
end
